# Ember mobile API
#
# Copy this file to .env and set a long random token:
#   openssl rand -hex 32
# The same value is entered once in the iPhone app and stored in its Keychain.
EMBER_API_TOKEN=replace-with-a-random-token-at-least-24-characters
EMBER_CACHE_MAX_MB=2048
EMBER_MAX_AUDIO_MB=48
# EMBER_RATE_LIMIT=60
# EMBER_MAX_JOBS=3

# Published loopback port; keep the existing deployment port if customized.
EMBER_HOST_PORT=18080
# Non-Docker runs: keep library storage outside EMBER_CACHE_DIR.
# EMBER_LIBRARY_DIR=/var/lib/ember/library
