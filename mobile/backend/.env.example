# Ember mobile API
#
# Copy this file to .env and set a long random token:
#   openssl rand -hex 32
# The same value is entered once in the iPhone app and stored in its Keychain.
EMBER_API_TOKEN=replace-with-a-random-token-at-least-24-characters
EMBER_CACHE_MAX_MB=2048
EMBER_MAX_AUDIO_MB=48
# EMBER_RATE_LIMIT=60
# EMBER_MAX_JOBS=3
# Peer address(es) of your reverse proxy, comma separated. Only then is its
# X-Forwarded-For believed, so rate limits apply per phone instead of per proxy.
# The proxy must APPEND the address it saw to X-Forwarded-For (nginx
# $proxy_add_x_forwarded_for; Caddy and Traefik do this by default), because only
# the last entry is read -- that is the one the proxy wrote itself. A proxy that
# forwards the client's own header unchanged, or a plain TCP forwarder that adds
# nothing, leaves the caller in charge of its own rate-limit key and the limit
# stops limiting anything.
# Under Docker this is the bridge gateway (often 172.17.0.1), not 127.0.0.1.
# EMBER_TRUSTED_PROXIES=

# Published loopback port; keep the existing deployment port if customized.
EMBER_HOST_PORT=18080
# Non-Docker runs: keep library storage outside EMBER_CACHE_DIR.
# EMBER_LIBRARY_DIR=/var/lib/ember/library
